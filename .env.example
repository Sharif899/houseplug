# ================================================
# HousePlug Osogbo — Environment Variables
# Copy this file to .env.local and fill in values
# NEVER commit .env.local to version control
# ================================================

# ── Supabase (Required) ──────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# ── Google AdSense (Add after approval) ─────────
# Get this from: google.com/adsense → Account → Publisher ID
NEXT_PUBLIC_ADSENSE_CLIENT_ID=ca-pub-XXXXXXXXXXXXXXXX

# ── AdSense Slot IDs (Create in AdSense Dashboard) ──
# Create 4 ad units in your AdSense account, paste slot IDs here
NEXT_PUBLIC_AD_SLOT_LEADERBOARD=1234567890
NEXT_PUBLIC_AD_SLOT_RECTANGLE=0987654321
NEXT_PUBLIC_AD_SLOT_INFEED=1122334455
NEXT_PUBLIC_AD_SLOT_INARTICLE=5544332211

# ── App Config ───────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=HousePlug Osogbo

# ── Google Analytics (Optional) ─────────────────
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX
